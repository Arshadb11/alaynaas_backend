# Server Environment Variables
PORT=3000
NODE_ENV=development

# MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=perfume_admin

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Hosted Redis (Upstash). If set, REDIS_HOST/PORT/PASSWORD are ignored.
REDIS_URL=

# Vercel Cron secret (any long random string) — protects /api/cron/trash-purge
CRON_SECRET=

# MySQL connections per serverless instance (default 3 on Vercel)
DB_POOL_LIMIT=
